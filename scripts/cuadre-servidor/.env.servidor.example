# Copiar a .env.servidor y completar. Lo lee el contenedor `app` (docker-compose).
APP_NAME="Arabito Cuadre"
APP_KEY=
APP_TIMEZONE=America/Caracas

# Sucursal a cuadrar (código en sucursals.codigo de la BD restaurada)
CUADRE_SUCURSAL=anaco

# Titanio POS
TITANIO_STORE_ID=
TITANIO_SUCURSAL=anaco
# TITANIO_SECRET=   (si no se define usa el secreto por defecto del código)
TITANIO_DESDE=2026-08-30
# TITANIO_HASTA=   (vacío = hoy)

# Parámetros del cuadre
CUADRE_MAX_SEGUNDOS=15
CUADRE_TOLERANCIA_BS=1
CUADRE_UMBRAL_AJUSTE=5

# Opciones extra para cuadre:completo (ej.: --sin-titanio, --desde-cero, --simular-antes)
CUADRE_OPCIONES=

# MariaDB del compose
DB_ROOT_PASSWORD=cuadre
DB_DATABASE=arabito
DB_BUFFER_POOL=1G
